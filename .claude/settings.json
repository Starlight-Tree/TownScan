{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(./backups/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.infisical/**)",
      "Read(~/.ssh/**)",
      "Bash(git commit *--no-verify*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Edit(**/CLAUDE.md)"
    ]
  }
}
