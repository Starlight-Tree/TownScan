# TownScan の環境変数（キー名だけ。値は入れない）。実際の .env は scripts/dev-up.sh が作る（Git には入れない）。
# 秘密の置き場: 秘密（GOOGLE_CLIENT_ID・GOOGLE_CLIENT_SECRET・BETTER_AUTH_SECRET・GEMINI_API_KEY）は、Infisical が正（JobNavi・DocuNavi と同じ。ADR 0004）。
#   scripts/login-secrets.sh で登録し、環境変数 TOWNSCAN_INFISICAL_PROJECT_ID を入れて scripts/dev-up.sh を流す（infisical run で compose に渡す）。
#   .env は、Infisical を使わないときの代わり（その場合、秘密は下に自分で書く）。infisical run の値は .env より優先される。
#   POSTGRES_PASSWORD は DB のボリュームと対（作り直すと接続できなくなる）ので、Infisical を使うときも .env に置く。
# DB のパスワード（scripts/dev-up.sh が乱数で作る。URL にそのまま入れるので、英数字だけにする）
POSTGRES_PASSWORD=
# 任意: web のイメージの作り方。prebuilt（ホストで作った .next/standalone を載せる。既定）か runtime（イメージの中でビルド）
WEB_TARGET=
# 任意: 返答のモデル。compose の既定は gemini（空でも gemini。下の GEMINI_API_KEY が要る。空だと api が起動時にエラー）。mock は、Claude Code が内部で検証するときだけ（利用者は使わない）
LLM_PROVIDER=
# 実 LLM（Gemini。任意）。Google AI Studio で作ったキーを、あなたが自分で書く。値は Git に入れない・誰にも見せない（ここは名前だけの見本）
GEMINI_API_KEY=
# 任意: モデル名。空なら既定（gemini-3.5-flash-lite）
GEMINI_MODEL=

# --- ログイン（任意。Google だけ）。書かなくても、ログイン以外の機能は使える。仕様: docs/spec-prototype.md §2.1 ---
# 署名鍵と Google のトークンの暗号化に使う乱数（.env で動かすときは scripts/dev-up.sh が、無いときだけ 1 回作って足す。Infisical を使うときは scripts/login-secrets.sh が作る。どちらも自分では書かない）。
# 一度決めたら変えない（変えると全員がログアウトに見える）。ここは名前だけの見本なので、コメントにしてある（空の行があると dev-up.sh が止まる）。
# BETTER_AUTH_SECRET=
# Google の OAuth クライアント（種類: ウェブ アプリケーション。Google Cloud Console で、あなたが作る）の値。リダイレクト URI は http://localhost:3500/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 任意: ブラウザーから見た web の URL（JWT の iss と Google のリダイレクト URI の元）。既定は http://localhost:3500
BETTER_AUTH_URL=
# 任意: JWT の対象（aud。web と api で同じ値になる）。既定は townscan
JWT_AUDIENCE=
